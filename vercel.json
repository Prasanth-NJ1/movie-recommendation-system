{
    "version": 2,
    "builds": [
        {
            "src": "wsgi.py",
            "use": "@vercel/python"
        },
        {
            "src": "frontend/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "wsgi.py"
        },
        {
            "src": "/(.*)",
            "dest": "frontend/$1"
        }
    ],
    "ignoreFiles": [
        "venv/**",
        "backend/venv/**",
        ".gitignore",
        ".vscode/**",
        "__pycache__/**"
    ]
}
