{
    "version": 2,
    "builds": [
        {
            "src": "frontend/index.html",
            "use": "@vercel/static"
        },
        {
            "src": "wsgi.py",
            "use": "@vercel/python"
        }
    ],
    "routes": [
        {
            "src": "/recommend/(.*)",
            "dest": "wsgi.py"
        },
        {
            "src": "/(.*)",
            "dest": "frontend/$1"
        }
    ]
}
